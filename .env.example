# Triolla Site Editor (legacy local drafts). When unset/false, /api/edits is inert.
NEXT_PUBLIC_EDITOR_ENABLED=false

# === Triolla CMS (/admin) ===

# NextAuth (Auth.js v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public origin of the deployed site (e.g. https://triolla.io). Required for
# OAuth callback URLs. Optional in local dev (defaults to NEXTAUTH_URL or http://localhost:3000).
AUTH_URL=

# Comma-separated allow-list of admin email addresses. Sign-ins from
# unlisted addresses are rejected.
ADMIN_EMAILS=ariel@triolla.io

# OPTIONAL: Google OAuth (recommended for primary admin auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL: Email magic-link via Resend.
RESEND_API_KEY=
RESEND_FROM=no-reply@triolla.io

# === CMS publish flow ===

# GitHub PAT with `contents:write` on this repo. Required for /api/cms/publish.
# In production (Coolify), set as a secret env var on the running container.
GITHUB_TOKEN=
# HTTPS clone URL of this repo. The publish endpoint rewrites it to inject the
# GITHUB_TOKEN at push time.
GIT_REMOTE_URL=https://github.com/<owner>/<repo>.git
GIT_BRANCH=main

# === Asset proxy (local dev) ===
# Set to the live site origin so WP asset URLs (/wp-content/, /wp-includes/) that
# haven't been downloaded to local CAS are proxied through. Only needed in dev.
# If CDN no longer has cached WP assets, leave empty and run download-html-assets
# on the remaining pages instead.
PROXY_ORIGIN=

# === Payload CMS (/cms) ===
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=
# Postgres connection string (Coolify-managed instance recommended)
DATABASE_URI=postgres://user:pass@localhost:5432/triolla_cms

# OPTIONAL: S3 / Cloudflare R2 for media uploads. If S3_BUCKET unset, uses local /media dir.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 endpoint example: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=

# === Coolify redeploy fallback ===
# Already used by the deploy pipeline; reused by /api/cms/redeploy.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_APP_UUID=
